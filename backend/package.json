{
  "name": "@lab365/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "db:check": "node src/scripts/checkDatabase.js",
    "db:create": "node src/scripts/createDatabase.js",
    "migration:run": "typeorm migration:run -d src/config/database.js",
    "migration:show": "typeorm migration:show -d src/config/database.js",
    "seed": "node src/seeds/seedAll.js",
    "seed:demo": "node src/seeds/seedDemo.js"
  },
  "dependencies": {
    "@lab365/contracts": "0.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  }
}
